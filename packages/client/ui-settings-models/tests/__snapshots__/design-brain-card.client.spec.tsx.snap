// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`connects and disconnects from settings with real callback results and accessible status 1`] = `"<section class="_card_ddf801" aria-label="Design brain" aria-busy="false"><h3 class="_title_ddf801">Design brain</h3><p class="_copy_ddf801">Optional design guidance and evidence-based review tools for your agents. Built-in premium output guides work without this connection. Tool calls send the brief and evidence your agent supplies to SaturnAI; they do not inspect a rendered website automatically.</p><p class="_status_ddf801" role="status">Design brain connected</p><p class="_endpoint_ddf801">https://saturnai.tools/api/mcp</p><p class="_copy_ddf801">mcp__saturnai__compose, mcp__saturnai__review</p><div class="_actions_ddf801"><button type="button" class="_button_4d2f85 _outline_4d2f85 _md_4d2f85">Refresh status</button><button type="button" class="_button_4d2f85 _outline_4d2f85 _md_4d2f85">Disconnect</button></div></section>"`;

exports[`shows localized profile ownership without an ineffective disconnect 1`] = `"<section class="_card_ddf801" aria-label="设计大脑" aria-busy="false"><h3 class="_title_ddf801">设计大脑</h3><p class="_copy_ddf801">为智能体提供可选的设计指导和基于证据的评审工具。内置高品质产出指南无需此连接。工具调用会将智能体提供的需求和证据发送给 SaturnAI；工具不会自动检查已渲染的网站。</p><p class="_status_ddf801" role="status">所需工具不可用。请刷新状态或重试连接。</p><p class="_copy_ddf801">由配置文件中的 SaturnAI MCP 条目管理。请在配置文件中启用、停用或重新连接该条目。</p><div class="_actions_ddf801"><button type="button" class="_button_4d2f85 _outline_4d2f85 _md_4d2f85">刷新状态</button></div></section>"`;
